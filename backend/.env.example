# ============================================================
# Roam AI Backend — Environment Variables
# Copy this to .env and fill in your real keys
# ============================================================

# --- Google Gemini API ---
# Get free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Amadeus Flight & Hotel API (Free Sandbox) ---
# Register at: https://developers.amadeus.com/
AMADEUS_API_KEY=your_amadeus_api_key_here
AMADEUS_API_SECRET=your_amadeus_api_secret_here
AMADEUS_BASE_URL=https://test.api.amadeus.com

# --- OpenTripMap (Places/Attractions) ---
# Free key at: https://opentripmap.io/product
OPENTRIPMAP_API_KEY=your_opentripmap_key_here

# --- ExchangeRate API (Currency) ---
# Free key at: https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=your_exchange_rate_key_here

# --- n8n Webhook URLs (from your n8n cloud instance) ---
N8N_EMAIL_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook/email-itinerary
N8N_PRICE_ALERT_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook/price-alert

# --- ChromaDB (local, no key needed) ---
CHROMA_PERSIST_DIR=./rag/chroma_db

# --- Server ---
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
